# ──────────────────────────────────────────────────────────────────────────
#  algo-trader — environment template
#  Copy to .env and fill in. NEVER commit the real .env.
#  Secrets (exchange API keys) belong in Vault, not here. See docs/SECURITY.md
# ──────────────────────────────────────────────────────────────────────────

# Global
COMPOSE_PROJECT_NAME=algotrader
ENV=development                       # development | staging | production
TZ=UTC
# Master safety switch. paper = no real orders are ever sent to an exchange.
# Flip to "live" ONLY after staged real-money validation. See docs/RISK.md
TRADING_MODE=paper                    # paper | live

# ── Ports ──
# Dashboard is published on ALL interfaces by default so you can reach it at
# http://<server-ip>:8130 right away. Everything else binds to 127.0.0.1.
# Later: set DASHBOARD_BIND=127.0.0.1 and put a reverse proxy + domain in front.
DASHBOARD_BIND=0.0.0.0
DASHBOARD_PORT=8130                   # Laravel admin (public)
POSTGRES_PORT=8131
REDIS_PORT=8132
NATS_CLIENT_PORT=8133
NATS_MONITOR_PORT=8134
PROMETHEUS_PORT=8135
GRAFANA_PORT=8136
LOKI_PORT=8137
VAULT_PORT=8138
ENGINE_METRICS_PORT=8139             # trading engine /metrics
AI_ENGINE_PORT=8140                  # AI engine (multi-provider router)
NEWS_PORT=8141                       # news intelligence /metrics
PORTFOLIO_PORT=8142                  # intelligence/portfolio/safety API

# ── Region & compliance (per-spoke) ──
REGION=us-east-1                     # us-east-1 (FinRA) | ap-south-1 (SEBI)

# ── AI provider keys (referenced by ai_provider_keys.secret_ref; keep in Vault
#    in prod). Leave blank to keep providers disabled. ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_LB_MODE=cost                      # round_robin|weighted|cost|performance|health

# ── News intelligence ──
NEWS_SOURCE=synthetic                # synthetic (offline) | rss
NEWS_WORKERS=3

# ── PostgreSQL / TimescaleDB ──
POSTGRES_DB=algotrader
POSTGRES_USER=algotrader
POSTGRES_PASSWORD=change_me_in_prod_use_vault
DATABASE_URL=postgres://algotrader:change_me_in_prod_use_vault@postgres:5432/algotrader

# ── Redis ──
REDIS_PASSWORD=change_me_in_prod_use_vault
REDIS_URL=redis://:change_me_in_prod_use_vault@redis:6379/0

# ── NATS ──
NATS_URL=nats://nats:4222

# ── Vault (dev mode token; production uses unseal keys + auto-unseal) ──
VAULT_ADDR=http://vault:8200
VAULT_DEV_ROOT_TOKEN=dev-only-root-token

# ── Grafana ──
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_in_prod

# ── Platform admin (created on first dashboard boot) ──
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345!

# ── Laravel ──
APP_KEY=                              # generate with: php artisan key:generate
# Set to your server's public IP now (http://<server-ip>:8130). Switch to the
# domain (e.g. https://trade.example.com) once a reverse proxy is in front.
APP_URL=http://72.61.236.191:8130
APP_ENV=local

# ── Risk limits (engine reads these at boot; can be overridden per-strategy) ──
RISK_MAX_PER_TRADE_PCT=0.5            # max % of equity risked per trade
RISK_DAILY_DRAWDOWN_PCT=3.0          # halt new entries after this daily loss
RISK_WEEKLY_DRAWDOWN_PCT=8.0
RISK_MAX_LEVERAGE=5
RISK_MAX_OPEN_POSITIONS=10
KILL_SWITCH=off                      # off | on  (on = flatten + halt everything)

# ── Exchange API keys: DO NOT put real keys here. Stored in Vault at
#    secret/exchanges/<exchange>. These point engine at testnet by default. ──
BINANCE_TESTNET=true
BYBIT_TESTNET=true
OKX_TESTNET=true
COINBASE_SANDBOX=true
